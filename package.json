{
  "name": "decky-quick-walkthrough",
  "version": "1.4.1",
  "description": "Quickly search, translate, ad-block, read, and bookmark game walkthroughs directly inside SteamOS via Decky Loader.",
  "repository": "https://github.com/vumaquan/decky-quick-walkthrough",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:backend": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "package": "npm run build && python3 scripts/package_zip.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steamos",
    "walkthrough",
    "guides"
  ],
  "author": "maQuan",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
